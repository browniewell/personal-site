---
import { Image } from 'astro:assets';
import { asset } from '../lib/images';

interface Props {
  project: {
    name: string;
    summary: string;
    learned?: string;
    built?: string;
    status: string;
    image?: string;
    links: { label: string; url: string }[];
  };
  showLearned?: boolean;
}
const { project, showLearned = true } = Astro.props;
const main = project.links[0];
---
<article class="card">
  <span class:list={['status', { complete: project.status === 'complete' }]}>{project.status === 'complete' ? 'Complete' : 'In progress'}</span>
  <h3>{main ? <a href={main.url}>{project.name}</a> : project.name}</h3>
  <p>{project.summary}</p>
  {showLearned && project.learned && <p class="learned"><span class="visually-hidden">What I learned: </span>{project.learned}</p>}
  {/* Decorative image: the title link above goes to the same place. */}
  {project.image && (
    <a class="card-image" href={main?.url} tabindex="-1" aria-hidden="true">
      <Image src={asset(project.image)!} alt="" width={560} densities={[1, 2]} />
    </a>
  )}
  {(project.built || project.links.length > 0) && (
    <div class="meta">
      {project.built && <span class="tag">{project.built}</span>}
      {project.links.map((l) => <a href={l.url}>{l.label}</a>)}
    </div>
  )}
</article>
