---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getPosts, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <article>
    <header class="post-head">
      <h1>{post.data.title}</h1>
      <div class="meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {post.data.tags.map((t) => <span class="tag">{t}</span>)}
        {post.data.draft && <span class="tag">draft</span>}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <p style="margin-top:48px"><a href="/writing/">← All writing</a></p>
</Base>
