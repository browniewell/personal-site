---
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/content';

const posts = await getPosts();
---
<Base title="Writing" description="Occasional posts on teams, testing, and side projects.">
  <div class="page-head">
    <p class="prompt">$ ls -t ~/writing</p>
    <h1>Writing</h1>
    <p>Occasional notes on teams, testing, and the things I'm building. No schedule, no pressure.</p>
  </div>
  {posts.length === 0 ? (
    <p class="empty">Nothing here yet. The first post is somewhere in drafts, I promise.</p>
  ) : (
    <ul class="posts">
      {posts.map((p) => (
        <li>
          <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
          <a href={`/writing/${p.id}/`}>{p.data.title}</a>
          {p.data.draft && <span class="tag">draft</span>}
        </li>
      ))}
    </ul>
  )}
  <p style="margin-top:32px"><a href="/rss.xml">Subscribe via RSS</a></p>
</Base>
