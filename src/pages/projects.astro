---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/content';

const projects = await getProjects();
---
<Base title="Projects" description="Side projects, and a small experiment in how much AI to involve.">
  <div class="page-head">
    <p class="prompt">$ ls ~/projects</p>
    <h1>Projects</h1>
  </div>
  <div class="prose">
    <p>
      These are small things I built to learn. Without quite planning it, they turned into an experiment:
      some I wrote entirely by hand, and some I let AI write while I reviewed the code. Each card says which.
      I'm not presenting this as expertise. I'm paying attention to where AI helps, where it doesn't, and what
      still needs a human in the loop.
    </p>
  </div>
  <section aria-label="Project list" style="margin-top:40px">
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p.data} />)}
    </div>
  </section>
</Base>
